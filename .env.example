# =============================================================================
# MultimediaToolKit: environment variables (TEMPLATE, never put real secrets here)
# Copy to .env for local Docker Compose, or set these in the Render / Vercel dashboards.
# REQUIRED IN PRODUCTION = the backend refuses to start without a valid value.
# =============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production.  production enforces access keys, PostgreSQL and SIGNING_SECRET.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------
# Local Docker Compose values (only used by docker-compose.yml, NOT for production):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multimediatoolkit
POSTGRES_PORT=5432
# PostgreSQL URL. For Neon use the connection string from the Neon console, e.g.
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# (postgres:// and postgresql:// are both accepted; the psycopg2 driver is selected automatically.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimediatoolkit
# Development only: fall back to local SQLite if PostgreSQL is unreachable (ignored in production).
ALLOW_SQLITE_FALLBACK=true

# ---------------------------------------------------------------------------
# Security & access (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------
# >= 32 random characters. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Render can generate it for you (render.yaml: generateValue: true).
SIGNING_SECRET=
# access_key (invite-only) | dev_open (local development only). Empty = automatic.
AUTH_MODE=
# Exact frontend origin(s), comma-separated, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
# Optional regex for extra origins such as Vercel preview URLs, e.g.
#   ^https://your-app(-[a-z0-9-]+)?\.vercel\.app$
ALLOWED_ORIGIN_REGEX=
# Public URL of the frontend (used in printed invite links)
FRONTEND_URL=http://localhost:3000
DOWNLOAD_URL_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# local = files in STORAGE_DIR (ephemeral on Render Free!) | s3 = any S3-compatible bucket
STORAGE_BACKEND=local
STORAGE_DIR=
MAX_UPLOAD_SIZE_BYTES=104857600
# Only when STORAGE_BACKEND=s3 (Backblaze B2, Cloudflare R2, MinIO, AWS S3):
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=mtk/
# Scratch space for running jobs (cleaned after each job)
WORK_DIR=

# ---------------------------------------------------------------------------
# Job queue / worker
# ---------------------------------------------------------------------------
# true = run the job worker inside the API process (single-service deploys such as Render Free)
EMBEDDED_WORKER=true
FFMPEG_TIMEOUT_SECONDS=600
JOB_STALE_AFTER_SECONDS=180
JOB_MAX_ATTEMPTS=2
# Optional Redis wake-ups (the database stays the source of truth)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
QUEUE_NOTIFY_REDIS=false

# ---------------------------------------------------------------------------
# CPU engines (Whisper speech-to-text, Kokoro TTS, Tesseract OCR)
# ---------------------------------------------------------------------------
# Where model weights are cached (put it on a drive with space). Empty = backend/models
MODEL_CACHE_DIR=
AUTO_DOWNLOAD_MODELS=true
# tiny | base | small  (use tiny on 512 MB servers)
WHISPER_DEFAULT_MODEL=base
# Optional explicit path to tesseract(.exe); auto-detected when empty
TESSERACT_CMD=
MAX_TEXT_CHARS=5000
MAX_TRANSCRIBE_SECONDS=1800

# ---------------------------------------------------------------------------
# Optional hosted AI provider (AI modes only; every conversion also has a CPU mode)
# none | cloudflare | huggingface
# ---------------------------------------------------------------------------
AI_PROVIDER=none
AI_TIMEOUT_SECONDS=120
# Cloudflare Workers AI: dash.cloudflare.com -> AI -> Workers AI (account id + API token
# with "Workers AI" permission). Has a free daily allowance; usage beyond it is billed.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_CAPTION_MODEL=@cf/llava-hf/llava-1.5-7b-hf
# Hugging Face Inference: huggingface.co/settings/tokens (fine-grained token with
# "Make calls to Inference Providers"). Small free monthly credit; usage beyond it is billed.
HF_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_CAPTION_MODEL=Salesforce/blip-image-captioning-large

# ---------------------------------------------------------------------------
# Local ports (docker-compose) and frontend
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=3000
# Frontend (set in Vercel): public URL of the backend API. Baked in at BUILD time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# false = unload Whisper/Kokoro after every job (lower idle RAM, slower next job)
KEEP_MODELS_LOADED=true
