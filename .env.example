# ==========================================
# MultimediaToolKit - Environment Variables
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multimediatoolkit
POSTGRES_PORT=5432
# Database connection URL for host machine access
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimediatoolkit

# Redis Queue & Cache
REDIS_PORT=6379
# Redis connection URL for host machine access
REDIS_URL=redis://localhost:6379/0

# Backend Service
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Service
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
