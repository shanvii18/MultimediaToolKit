# ==========================================
# MultimediaToolKit - Environment Variables
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multimediatoolkit
POSTGRES_PORT=5432
# Database connection URL for host machine access
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimediatoolkit

# Redis Queue & Cache
REDIS_PORT=6379
# Redis connection URL for host machine access
REDIS_URL=redis://localhost:6379/0

# Backend Service
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Service
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Access control (invite-only). Unset = "dev_open" in development, "access_key" otherwise.
# dev_open is refused at startup outside ENVIRONMENT=development.
AUTH_MODE=
# Secret for short-lived signed download links. REQUIRED outside development (min 32 chars).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SIGNING_SECRET=
# Frontend origin used in printed invite links (python -m app.cli invite --email ...)
FRONTEND_URL=http://localhost:3000

# Job processing: run the durable job worker inside the API process (single-service deploys)
EMBEDDED_WORKER=true
FFMPEG_TIMEOUT_SECONDS=600

# Storage backend: "local" (STORAGE_DIR) or "s3" (any S3-compatible bucket, e.g. Backblaze B2 / Cloudflare R2)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=mtk/

# CPU AI engines. Put model weights on a drive with free space.
MODEL_CACHE_DIR=
AUTO_DOWNLOAD_MODELS=true
WHISPER_DEFAULT_MODEL=base
# Optional explicit path to the tesseract binary (auto-detected when empty)
TESSERACT_CMD=

# Optional hosted AI provider for AI modes (text→image, image description). "none" | "cloudflare" | "huggingface"
AI_PROVIDER=none
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_CAPTION_MODEL=@cf/llava-hf/llava-1.5-7b-hf
HF_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_CAPTION_MODEL=Salesforce/blip-image-captioning-large

# Wake workers instantly via Redis (the database remains the source of truth)
QUEUE_NOTIFY_REDIS=false
